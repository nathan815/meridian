{
  "manifest_version": 3,
  "name": "Meridian",
  "version": "1.2.0",
  "optional_permissions": ["bookmarks", "history"],
  "permissions": ["alarms", "favicon", "geolocation", "notifications", "offscreen", "storage"],
  "description": "Your local workspace, across time zones.",
  "background": {"service_worker": "service-worker.js"},
  "chrome_url_overrides": {"newtab": "index.html"}
}
